#include <stdio.h>
#include<string.h>
int main() {
    int n;
    scanf("%d",&n);
    int a[n],r[n],d[n];
    char e[n][100];
    for(int i=0;i<n;i++)
    {
        scanf("%s %d %d",e[i],&r[i],&d[i]);
    }
    for(int i=0;i<n-1;i++)
    {
      for(int j=i+1;j<n;j++)
      {
          if(r[i]>r[j]||(r[i]==r[j]&&d[i]>d[j])||(r[i]==r[j] && d[i]==d[j] && strcmp(e[i],e[j])>0))
          {
              int t1=r[i];
              r[i]=r[j];
              r[j]=t1;
              int t2=d[i];
              d[i]=d[j];
              d[j]=t2;
              char t3[100];
              strcpy(t3,e[i]);
              strcpy(e[i],e[j]);
              strcpy(e[j],t3);
          }
      }
    }
     for(int i=0;i<n;i++)
    {
        printf("%s %d %d\n",e[i],r[i],d[i]);
    }
    return 0;
}
