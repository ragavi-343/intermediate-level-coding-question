#include<stdio.h> 
#include<stdlib.h> 
#include<string.h> 
int main() 
{
 char s[1000]; 
scanf("%s",s); 
int n=strlen(s); 
int t[2],j=0,c=0; 
for(int i=0;i<n;i++) {
 if(s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u'||s[i]=='A'||s[i]=='E'||s[i]=='I'||s[i]=='O'||s[i]=='U')
 { c++;
  t[j++]=i;
 } 
if(c==2) { 
char temp=s[i];
 s[i]=s[t[0]];
 s[t[0]]=temp; 
c=0;
 } 
}
 printf("%s",s); }
